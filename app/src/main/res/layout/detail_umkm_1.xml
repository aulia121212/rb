<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.notifications.DetailUMKMFragment1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/umkm1_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_rb"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/logorb"
                    android:paddingStart="37dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/title_umkm1"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center_vertical"
                        android:text="Gothirty Handmade"
                        android:textColor="@color/blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/button_wa"
                        android:layout_width="200dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/wa_detail"
                        android:paddingStart="24dp"
                        android:gravity="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/title_umkm1" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/description_title"
                android:layout_marginTop="25dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Deskripsi Produk"
                android:textColor="@color/blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal" />

            <View
                android:id="@+id/line_below_text"
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"
                android:background="@color/blue"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/text_umkm1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:justificationMode="inter_word"
                android:fontFamily="@font/poppins_regular"
                android:text="Dimulai sejak tahun 2011 berawal dari ketertarikan akan kulit kayu yang hanya diolah secara sederhana dan digunakan untuk keperluan adat dan peralatan sehari-hari saja lalu dikembangkan menjadi produk yang bermanfaat dan bernilai jual tinggi. \n\nGothirty Handmade adalah produk kerajinan dari Kulit Kayu yang dibuat secara tradisional dengan skill tinggi oleh pengrajin local. Seiring dengan waktu dan respon yang baik, produk Gothirty semakin berkembang. Lebih variative dari segi varian dan meningkat secara kualitas.\n\nDemi menghasilkan produk yang berkualitas, produk Gothirty telah mendapatkan proses lanjutan sehingga tahan air, tahan jamur, dan tahan rayap. Hingga kini produk Gothirty dapat dijangkau dari berbagai wilayah di Indonesia melalui media online." />

            <TextView
                android:id="@+id/kosongdetailkatalog_bpp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="58dp"
                android:layout_marginEnd="16dp"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>
    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>

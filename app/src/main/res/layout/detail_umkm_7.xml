<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar dengan Tombol Back -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@color/white"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_collapseMode="pin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tombol Back di dalam Toolbar -->
        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_back_24"
            android:layout_gravity="start"/>

        <LinearLayout
            android:id="@+id/umkm1_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_rb"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="2dp"
                android:paddingStart="1dp"
                android:src="@drawable/umkm_7" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/title_umkm1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center_vertical"
                    android:text="Edrusya Snack"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/title_umkm1"
                    android:id="@+id/klik_wa"
                    android:layout_marginTop="5dp">

                    <ImageButton
                        android:id="@+id/button_wa"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="35dp"
                        android:background="@drawable/button_wa"
                        android:paddingStart="24dp"
                        android:gravity="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/actionBarSize"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:id="@+id/description_title"
                android:layout_marginTop="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Deskripsi Produk"
                android:textColor="@color/blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal" />
            <View
                android:id="@+id/line_below_text"
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"
                android:background="@color/blue"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/judul1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:text="Kriwang ( kripik bawang)"
                android:textSize="16sp"
                android:textColor="@color/blue"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintTop_toBottomOf="@id/line_below_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- Text UMKM 3 -->
            <TextView
                android:id="@+id/text_umkm3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:text="Kripik bawang cemilan yang bergizi cocok buat yang suka ngemil tanpa merasa bersalah bergizi tinggi di jamin nagih deh"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_regular"
                android:justificationMode="inter_word"
                app:layout_constraintTop_toBottomOf="@id/judul1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Harga 1 -->
            <TextView
                android:id="@+id/harga1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="Berat Bersih Produk: 100gr\nHarga Jual Produk: 13.000"
                android:textSize="16sp"
                android:textColor="@color/blue"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintTop_toBottomOf="@id/text_umkm3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- Image Line 2 -->
            <ImageView
                android:id="@+id/image_line2"
                android:layout_width="1000dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/line"
                app:layout_constraintTop_toBottomOf="@id/harga1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Judul 2 -->
            <TextView
                android:id="@+id/judul2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="Banchomer"
                android:textSize="16sp"
                android:textColor="@color/blue"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintTop_toBottomOf="@id/image_line2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Text UMKM 3_2 -->
            <TextView
                android:id="@+id/text_umkm3_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="Banchomer kripik pisang coklat lumer cemilan yang manis dan gurih  bergizi tinggi cocok bagi yang suka coklat di jamin nagih deh"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_regular"
                android:justificationMode="inter_word"
                app:layout_constraintTop_toBottomOf="@id/judul2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Harga 2 -->
            <TextView
                android:id="@+id/harga2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:text="Berat Bersih Produk: 100gr\nHarga Jual Produk: 20.000"
                android:textSize="16sp"
                android:textColor="@color/blue"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintTop_toBottomOf="@id/text_umkm3_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/kosongdetailkatalog_bpp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="58dp"
                android:layout_marginEnd="16dp"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- Toolbar dengan Tombol Back -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@color/white"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_collapseMode="pin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tombol Back di dalam Toolbar -->
        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/baseline_arrow_back_24"
            android:layout_gravity="start"/>

        <LinearLayout
            android:id="@+id/umkm1_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_rb"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="2dp"
                android:paddingStart="1dp"
                android:src="@drawable/umkm_12" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/title_umkm1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center_vertical"
                    android:text="CV KREASI MAMA PAPA"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/button_wa"
                    android:layout_width="200dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/button_wa"
                    android:paddingStart="24dp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/title_umkm1" />

            </LinearLayout>
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:id="@+id/description_title"
                android:layout_marginTop="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Deskripsi Produk"
                android:textColor="@color/blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal" />
            <View
                android:id="@+id/line_below_text"
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"
                android:background="@color/blue"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/judul1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Bagelen Sikrispii "
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/text_umkm3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:justificationMode="inter_word"
                android:fontFamily="@font/poppins_regular"
                android:text="Hey Snack Lovers! 🌟 Mau ngemil enak tapi tetap sehat? Yuk, kenalan dengan Bagelen Sikrispii Classic Butter! Produk baru yang bikin ngemil jadi makin asyik dan bergizi.
                \n\nInterest
\nDibuat dari bahan-bahan premium seperti tepung terigu, gula, garam, butter, susu, dan whipping cream. Bagelen Sikrispii Classic Butter ini menghadirkan sensasi crispy yang gak bisa kamu tolak. Rasanya? Gurih, manis, dan bikin nagih di setiap gigitan!

\n\nDesire
\nBayangkan, setiap gigitan Bagelen Sikrispii mengingatkanmu pada rasa nostalgia roti bakar yang disajikan dengan penuh cinta. Cocok banget buat menemani waktu santai kamu atau jadi teman nonton film favorit. Dan yang paling penting, produk ini sudah bersertifikasi Halal dan terjamin kualitasnya!

\n\nAction
\nJangan sampai kehabisan! Dapatkan sekarang juga di toko terdekat atau cek Instagram kami @BagelenSikrispii untuk info lebih lanjut. Nikmati sensasi ngemil yang beda dari biasanya
"
                app:layout_constraintTop_toBottomOf="@id/line_below_text" />

            <TextView
                android:id="@+id/harga1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Berat Bersih Produk: 80gr\nHarga Jual Produk: 21.000"
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


            <ImageView
                android:id="@+id/image_line2"
                android:layout_width="1000dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/line"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/judul2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Roti sisir balikpapan"
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/text_umkm3_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:justificationMode="inter_word"
                android:fontFamily="@font/poppins_regular"
                android:text="Teman Santaimu yang Bikin Nagih!

\n\nKamu lagi cari cemilan yang bisa bikin mood naik seharian? Cobain deh roti sisir kita! Roti lembut yang meleleh di mulut dengan aroma yang menggoda. Dijamin, sekali gigit, susah berhenti!

\n\nKenapa Harus Roti Sisir Kami?
\n-Lembut Banget: Setiap gigitan bikin kamu serasa di awan!
\n-Aroma Menggoda: Harum rotinya bikin lapar instan.
\n-Rasa Juara: Bukan cuma enak, tapi juga bikin ketagihan.

\n\nPas banget buat teman ngopi, sarapan, atau sekadar ngemil cantik bareng temen-temen. Yuk, jadikan harimu lebih manis dan seru dengan roti sisir!"
                app:layout_constraintTop_toBottomOf="@id/line_below_text" />

            <TextView
                android:id="@+id/harga2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Berat Bersih Produk: 350gr\nHarga Jual Produk: 45.000"
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


            <ImageView
                android:id="@+id/image_line3"
                android:layout_width="1000dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/line"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/judul3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Borneo Floss Roll "
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/text_umkm3_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:justificationMode="inter_word"
                android:fontFamily="@font/poppins_regular"
                android:text="Attention (Perhatian)
\n😲 Baru! Roti Gulung Abon yang Bikin Ngiler dari Mamapapa Bakery!

            \n\nInterest (Minat)
            \nBayangin roti lembut yang melt di mulut, ditambah abon gurih yang nge-blend sempurna. Gimana nggak tergoda?

            \n\nDesire (Keinginan)
            \nRasain sensasi kriuk-kriuk abon yang bikin gigitan pertama langsung jatuh cinta. Cocok buat ngemil santai atau temen nugas!

            \n\nAction (Tindakan)
            \nJangan sampai ketinggalan, yuk cepetan order di Mamapapa Bakery. Klik link di bio atau langsung mampir ke toko kami. Let's roll with flavor! 🍞✨"

                app:layout_constraintTop_toBottomOf="@id/line_below_text" />

            <TextView
                android:id="@+id/harga3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Berat Bersih Produk: 350gr\nHarga Jual Produk: 55.000"
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/kosongdetailkatalog_bpp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="58dp"
                android:layout_marginEnd="16dp"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

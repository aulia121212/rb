<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.faq.FAQFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/image_faq"
            android:layout_width="150dp"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/faqfaq"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/tanya1"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/tanya_a"
            app:layout_constraintTop_toBottomOf="@id/image_faq"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_tanya1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="32dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:text="Aplikasi Rumah BUMN adalah platform digital yang dikembangkan untuk mendukung dan mempromosikan produk-produk UMKM (Usaha Mikro, Kecil, dan Menengah) di Indonesia. Tujuannya adalah untuk membantu UMKM meningkatkan visibilitas, akses pasar, dan penjualan produk mereka melalui jaringan BUMN yang ada di seluruh Indonesia. Aplikasi ini memungkinkan UMKM untuk memasarkan produk mereka secara online dan menjangkau lebih banyak pelanggan."
            android:textColor="@color/black"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/tanya1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/tanya2"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/tanya_b"
            app:layout_constraintTop_toBottomOf="@id/text_tanya1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_tanya2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="32dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:text="Untuk melakukan pemesanan pada menu katalog, Anda akan diarahkan menuju WhatsApp Rumah BUMN Kalimantan Timur yang tersedia di setiap kota. Dengan demikian, Anda dapat dengan mudah memesan produk atau layanan yang diinginkan sesuai dengan lokasi terdekat Anda."
            android:textColor="@color/black"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/tanya2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/tanya3"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/tanya_c"
            app:layout_constraintTop_toBottomOf="@id/text_tanya2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_tanya3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="32dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:text="Pembayaran dapat dilakukan menggunakan uang tunai (cash) atau melalui transfer bank. Selain itu, untuk mempermudah akses dan pelayanan, Rumah BUMN Kalimantan Timur telah hadir di 5 kota yaitu Balikpapan,Samarinda,Kutai Kartanegara,Berau dan Penajam Paser Utara, setiap kota ini dengan siap melayani kebutuhan masyarakat dengan berbagai fasilitas dan program unggulan."
            android:textColor="@color/black"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/tanya3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/tanya4"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/tanya_d"
            app:layout_constraintTop_toBottomOf="@id/text_tanya3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_tanya4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="32dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:text="Tidak perlu, untuk melakukan pemesanan pada menu katalog, Anda akan diarahkan menuju WhatsApp Rumah BUMN Kalimantan Timur yang tersedia di setiap kota. Dengan demikian, Anda dapat dengan mudah memesan produk atau layanan yang diinginkan tanpa harus membuat akun terlebih dahulu."
            android:textColor="@color/black"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/tanya4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/tanya5"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/tanya_e"
            app:layout_constraintTop_toBottomOf="@id/text_tanya4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_tanya5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="32dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:text="Untuk menghubungi layanan pelanggan, Anda dapat langsung mengirim pesan melalui WhatsApp Rumah BUMN Kalimantan Timur yang tersedia di setiap kota. Layanan pelanggan kami siap membantu Anda dengan informasi dan bantuan yang Anda butuhkan terkait produk atau layanan yang ditawarkan."
            android:textColor="@color/black"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/tanya5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/tanya6"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/tanya_f"
            app:layout_constraintTop_toBottomOf="@id/text_tanya5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_tanya6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="32dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:text="Untuk bergabung dengan aplikasi Rumah BUMN maka anda cukup mendaftar melalui link goggle form yang tersedia di Bio Instagram masing-masing Instagram Rumah BUMN Kalimantan Timur."
            android:textColor="@color/black"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/tanya6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/tanya7"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/tanya_g"
            app:layout_constraintTop_toBottomOf="@id/text_tanya6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_tanya7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="32dp"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_regular"
            android:text="Menggunakan aplikasi Rumah BUMN menawarkan berbagai keuntungan bagi UMKM. Pertama, UMKM mendapatkan akses ke berbagai program pelatihan dan workshop yang dapat meningkatkan keterampilan serta pengetahuan bisnis mereka. Selain itu, aplikasi ini memungkinkan UMKM untuk terhubung dengan jaringan bisnis yang lebih luas, termasuk mitra usaha, pemasok, dan pelanggan potensial. Melalui aplikasi ini, UMKM dapat memanfaatkan platform promosi dan pemasaran untuk menjangkau lebih banyak konsumen. Rumah BUMN juga menyediakan layanan pendampingan dan konsultasi bisnis untuk membantu UMKM mengatasi berbagai tantangan yang dihadapi.\n\nAplikasi ini memberikan akses lebih mudah ke berbagai program pembiayaan yang ditawarkan oleh pemerintah dan lembaga keuangan. Dengan fasilitas pembayaran yang mudah dan aman, baik melalui transfer bank atau pembayaran tunai, serta integrasi dengan WhatsApp untuk pemesanan, transaksi menjadi lebih efisien. Selain itu, UMKM dapat memperoleh informasi terkini tentang kebijakan pemerintah, peluang pasar, dan perkembangan industri yang relevan. Aplikasi ini juga mendorong kolaborasi antar pelaku UMKM dan inovasi dalam produk serta layanan mereka. Dengan semua keuntungan ini, aplikasi Rumah BUMN menjadi alat yang sangat bermanfaat bagi UMKM dalam mengembangkan dan memperluas usaha mereka."
            android:textColor="@color/black"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@id/tanya7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/kosongfaq"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="58dp"
            android:layout_marginEnd="16dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/text_tanya7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

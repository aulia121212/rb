<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/umkm1_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/image_rb"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logorb"
            android:paddingStart="37dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/title_umkm2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cimi Cimi Keju (Thalitha Bakery)"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/blue"
                android:fontFamily="@font/poppins_bold" />

            <ImageButton
                android:id="@+id/button_wa"
                android:layout_width="200dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/wa_detail"
                android:gravity="center"
                android:paddingStart="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Deskripsi Produk Title -->
    <TextView
        android:id="@+id/description_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Deskripsi Produk"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/blue"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/umkm1_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Garis Biru di Bawah Title -->
    <View
        android:id="@+id/line_below_text"
        android:layout_width="160dp"
        android:layout_height="1dp"
        android:layout_marginTop="1dp"
        android:background="@color/blue"
        android:layout_gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/description_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Deskripsi Produk -->
    <TextView
        android:id="@+id/text_umkm3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:text="Cimi2 Keju adalah olahan rumahan di Balikpapan cemilan yang dikombinasikan antara tepung ketan, telur, keju, dan mentega, menciptakan kres kriuk dan rasa yang sedap. Ciptakan senyum dan tawa bahagia..."
        android:textSize="16sp"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins_regular"
        android:justificationMode="inter_word"
        app:layout_constraintTop_toBottomOf="@id/line_below_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Informasi Komposisi, Berat Bersih, dan Harga -->
    <TextView
        android:id="@+id/harga1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        android:text="Komposisi: Tepung ketan, telur, mentega, keju, dan air\nBerat Bersih Produk: 90gr\nHarga Jual Produk: Rp 25.000"
        android:textSize="16sp"
        android:textColor="@color/blue"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintTop_toBottomOf="@id/text_umkm3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

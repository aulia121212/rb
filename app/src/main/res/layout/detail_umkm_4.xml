<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/back_arrow"
        android:layout_width="40dp"
        android:layout_height="30dp"
        android:layout_margin="16dp"
        android:src="@drawable/back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/umkm1_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/image_rb"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="2dp"
                    android:src="@drawable/logorb"
                    android:paddingStart="37dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/title_umkm4"
                        android:layout_marginTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center_vertical"
                        android:text="Kampoeng Timur"
                        android:textColor="@color/blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/button_wa"
                        android:layout_width="200dp"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/wa_detail"
                        android:paddingStart="24dp"
                        android:gravity="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/description_title"
                android:layout_marginTop="25dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Deskripsi Produk"
                android:textColor="@color/blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal" />

            <View
                android:id="@+id/line_below_text"
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:layout_marginTop="1dp"
                android:background="@color/blue"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/judul1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Abon Rajungan"
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/text_umkm3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:justificationMode="inter_word"
                android:fontFamily="@font/poppins_regular"
                android:text="Abon Rajungan terbuat dari 100 % daging kepiting Segar  berkualitas yang di padukan dengan bumbu rempah-rempah pilihan menghasilkan cita rasa yang unik dan khas .
                \n\nDengan bahan Baku yang melimpah (Kepiting) kami dari Balikpapan Kalimantan timur Telah berinovasi membuat cemilan /Snack /oleh-oleh yang mempunyai cita rasa yang khas ,unik dan pastinya Bikin nagih .

                \n\nAbon Rajungan Kampoeng Timoer :
                \n✓Bersertifikat HALAL MUI
                \n✓Bersertifikat GMP
                \n✓Bersertifikat ISO 9001 : 2008

                \n\nJadi sudah terjamin Kemutuanya , Kualitasnya , dan higienis
                \nTerlebih Peyek kepiting ini diproduksi dengan skala internasional ,jadi Terjamin !
                \n\nAbon Rajungan selain Bergizi ,Sehat , Enak dan Gurih.
                \n\nAbon Rajungan  Tahan 12 bulan (Tanpa Bahan Pengawet).
                \n\nJadi gak perlu khawatir tuh untuk masa kedaluwarsa nya 😍 \n\nCocok untuk Cemilan / Lauk Pauk."
                app:layout_constraintTop_toBottomOf="@id/line_below_text" />

            <TextView
                android:id="@+id/harga1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Berat Bersih Produk: 50gr\nHarga Jual Produk: 35.000-40.000"
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


            <ImageView
                android:id="@+id/image_line2"
                android:layout_width="1000dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/line"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/judul2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Peyek Kepiting"
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/text_umkm3_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:justificationMode="inter_word"
                android:fontFamily="@font/poppins_regular"
                android:text="Peyek kepiting terbuat dari 100 % daging kepiting asli dan Segar  berkualitas yang di padukan dengan bumbu rempah-rempah pilihan menghasilkan cita rasa yang unik dan khas .

            \n\nDengan bahan Baku yang melimpah (Kepiting) kami dari Balikpapan Kalimantan timur Telah berinovasi membuat cemilan /Snack /oleh-oleh yang mempunyai cita rasa yang khas ,unik dan pastinya Bikin nagih .

            \n\nPeyek kepiting Kampoeng Timoer :
            \n✓Bersertifikat HALAL MUI
            \n✓Bersertifikat GMP
            \n✓Bersertifikat ISO 9001 : 2008

            \n\nJadi sudah terjamin Kemutuanya , Kualitasnya , dan higienis
            \nTerlebih Peyek kepiting ini diproduksi dengan skala internasional ,jadi Terjamin !

            \n\nPeyek kepiting selain Bergizi ,Sehat , Enak dan Gurih.

            \n\nPeyek Kepiting Tahan 6 bulan lhoo (Tanpa Bahan Pengawet).

            \n\nJadi gak perlu khawatir tuh untuk masa kedaluwarsa nya 😍

            \n\nCocok untuk Cemilan / Lauk Pauk .

            \n\nPeyek Kepiting Kampoeng Timoer adalah Icon Oleh-oleh NO 1 Di Balikpapan (Kalimantan Timur ) .

            \n\nRasanya jangan ditanya dijamin bikin Nagih !!!
            \nBuktikan sendiri ."
                app:layout_constraintTop_toBottomOf="@id/line_below_text" />

            <TextView
                android:id="@+id/harga_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Berat Bersih Produk: 85gr\nHarga Jual Produk: 27.000-30.000 "
                android:textColor="@color/blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />


        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
